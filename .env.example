# Set verified values before making a public build. Leave blank for local previews.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=modivo2026@gmail.com
# Set only after the legal drafts have been replaced and reviewed.
NEXT_PUBLIC_LEGAL_APPROVED=false

# Empty for user/organization Pages; /repository-name for project Pages.
NEXT_PUBLIC_BASE_PATH=

# Off until live store, product, checkout, delivery and legal checks are complete.
NEXT_PUBLIC_SALES_ENABLED=false
# Optional, free Cloudflare Web Analytics; no script loads until visitor opt-in.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_REVIEWED=false
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
